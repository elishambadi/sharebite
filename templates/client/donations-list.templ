package templates

import "github.com/elishambadi/sharebite/models"
import "strconv"

templ DonationsList(donations []models.Donation) {
    <!-- donations.templ -->

    <div class="max-w-4xl mx-auto bg-white p-8 rounded-lg shadow-lg space-y-8">
        <h1 class="text-4xl font-extrabold text-center text-gray-800">Donations</h1>

        <div class="flex justify-center">
            <input
                id="search-input"
                type="text"
                placeholder="Search by food type..."
                class="px-4 py-2 w-1/3 border border-gray-300 rounded-md"
                hx-get="/app/donations"
                hx-target="#donations-list"
                hx-trigger="keyup changed delay:500ms"
            />
        </div>

        for _, donation := range donations {

        <section class="space-y-6">
            <!-- Donation Image -->
            <div class="flex justify-center mb-6">
                <img src="{{ donation.ImageURL }}" alt="Donation Image" class="rounded-lg w-full h-72 object-cover shadow-md">
            </div>

            

            <!-- Donation Information -->
            <h2 class="text-2xl font-semibold text-blue-600">Donation Information</h2>
            <div class="space-y-4">
                <p class="text-lg text-gray-700">
                    <span class="font-semibold">Food Type:</span> { donation.FoodType }
                </p>
                <p class="text-lg text-gray-700">
                    <span class="font-semibold">Quantity:</span> { strconv.Itoa(donation.Quantity) } items
                </p>
                <p class="text-lg text-gray-700">
                    <span class="font-semibold">Location:</span> { donation.Location }
                </p>
                <p class="text-lg text-gray-700">
                    <span class="font-semibold">Urgency:</span> { donation.Urgency }
                </p>
                <p class="text-lg text-gray-700">
                    <span class="font-semibold">Donor:</span> { donation.Donor.Name }
                </p>
            </div>

            <!-- Buttons for Action (e.g., approve, reject) -->
            <div class="flex justify-center space-x-4">
                <button class="bg-green-600 text-white font-semibold py-2 px-6 rounded-lg hover:bg-green-700 focus:outline-none focus:ring-2 focus:ring-green-500">
                    Approve
                </button>
                <button class="bg-red-600 text-white font-semibold py-2 px-6 rounded-lg hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-red-500">
                    Reject
                </button>
            </div>
        </section>

        }
    </div>

}