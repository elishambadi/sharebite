package templates

templ Profile() {
    <!DOCTYPE html>
    <html lang="en">
    <head>
        <meta charset="UTF-8">
        <meta name="viewport" content="width=device-width, initial-scale=1.0">
        <title>User Profile</title>
    </head>
    <body>
        <header>
            <h1>Your Profile</h1>
        </header>
        <main>
            <section>
                <h2>Profile Information</h2>
                <p>Name: John Doe</p>
                <p>Email: johndoe@example.com</p>
                <p>More user details go here...</p>
            </section>
        </main>
    </body>
    </html>

}